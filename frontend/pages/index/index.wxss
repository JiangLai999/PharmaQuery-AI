.hero-panel {
  position: relative;
  margin-bottom: 24rpx;
  padding: 36rpx 28rpx;
  background: linear-gradient(145deg, #1f6ee9 0%, #5e97ff 62%, #8eb8ff 100%);
  color: #fff;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-overline {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2.6rpx;
  line-height: 1.5;
  opacity: 0.8;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 44rpx;
  line-height: 1.32;
  letter-spacing: 0.6rpx;
  font-weight: 700;
  word-break: break-word;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  max-width: 520rpx;
  opacity: 0.92;
  word-break: break-word;
}

.hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.hero-user {
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.9;
  word-break: break-word;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero-orb-large {
  width: 220rpx;
  height: 220rpx;
  right: -50rpx;
  top: -30rpx;
}

.hero-orb-small {
  width: 120rpx;
  height: 120rpx;
  right: 90rpx;
  bottom: -30rpx;
}

.search-entry {
  margin-bottom: 28rpx;
}

.search-symbol {
  width: 40rpx;
  font-size: 36rpx;
  color: #2c7ef8;
}

.search-copy {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.search-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1f2a37;
  word-break: break-word;
}

.search-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #7b8794;
  word-break: break-word;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.action-card {
  width: 344rpx;
  min-width: 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(228, 234, 242, 0.96);
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 42, 55, 0.06);
  margin-bottom: 16rpx;
}

.action-card:active {
  transform: translateY(2rpx);
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #eaf2ff 0%, #dfeeff 100%);
  color: #2c7ef8;
  font-size: 30rpx;
  font-weight: 700;
}

.action-title {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #1f2a37;
  word-break: break-word;
}

.action-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #7b8794;
  word-break: break-word;
}

.alert-panel {
  padding-top: 12rpx;
}

.alert-summary-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.alert-summary-card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(228, 234, 242, 0.96);
  border-radius: 22rpx;
}

.alert-summary-title {
  display: block;
  font-size: 22rpx;
  line-height: 1.4;
  color: #7b8794;
}

.alert-summary-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #1f2a37;
}

.alert-summary-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 20rpx;
  line-height: 1.55;
  color: #7b8794;
}

.alert-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.alert-item:last-child {
  border-bottom: none;
}

.alert-main {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.alert-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1f2a37;
  word-break: break-word;
}

.alert-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b8794;
  word-break: break-word;
}

.alert-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.alert-reason-tag {
  background: #f3f8ff;
  color: #2c7ef8;
}

.alert-tag-warning {
  background: #fff6e5;
  color: #d48806;
}

.alert-tag-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.category-card {
  width: 344rpx;
  min-width: 0;
  padding: 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 248, 255, 0.98) 100%);
  border: 1rpx solid rgba(228, 234, 242, 0.96);
  margin-bottom: 16rpx;
}

.category-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1f2a37;
  word-break: break-word;
}

@media (max-width: 375px) {
  .hero-panel {
    padding: 32rpx 24rpx;
  }

  .hero-title {
    font-size: 40rpx;
  }

  .hero-desc {
    max-width: none;
  }

  .search-entry {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .action-grid,
  .category-grid {
    gap: 12rpx;
  }

  .alert-summary-grid {
    flex-wrap: wrap;
    gap: 12rpx;
  }

  .alert-summary-card {
    width: calc(50% - 6rpx);
    flex: none;
  }

  .action-card,
  .category-card {
    width: 339rpx;
    padding: 20rpx;
  }

  .action-title,
  .category-name,
  .alert-name {
    font-size: 26rpx;
  }

  .action-desc,
  .search-subtitle,
  .alert-desc,
  .category-count {
    font-size: 20rpx;
  }

  .alert-summary-desc {
    font-size: 18rpx;
  }
}

.category-count {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #2c7ef8;
  word-break: break-word;
}
