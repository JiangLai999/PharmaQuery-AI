.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 28rpx 32rpx;
  background:
    radial-gradient(circle at top, rgba(255, 255, 255, 0.22), transparent 30%),
    linear-gradient(180deg, #1664da 0%, #70a0ff 32%, #f2f6fb 33%, #f5f8fc 100%);
}

.login-hero {
  text-align: center;
  padding: 120rpx 0 56rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 1.4rpx;
}

.app-icon {
  font-size: 84rpx;
  display: block;
  margin: 22rpx 0 18rpx;
  color: #fff;
}

.app-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.32;
  letter-spacing: 0.5rpx;
  color: #fff;
  margin-bottom: 12rpx;
  word-break: break-word;
}

.app-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.8;
  max-width: 560rpx;
  margin: 0 auto;
  word-break: break-word;
}

.login-form {
  width: 100%;
  padding: 36rpx 28rpx;
}

.form-title-wrap {
  margin-bottom: 28rpx;
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1f2a37;
  word-break: break-word;
}

.form-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.72;
  color: #7b8794;
  word-break: break-word;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #52606d;
  margin-bottom: 12rpx;
}

.form-input {
  min-height: 88rpx;
  background: #f7f9fc;
  padding: 0 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.login-btn {
  margin-top: 20rpx;
  font-size: 32rpx;
  letter-spacing: 1rpx;
}

.login-footer {
  margin-top: auto;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #8c9bab;
  word-break: break-word;
}

@media (max-width: 375px) {
  .login-page {
    padding: 0 22rpx 28rpx;
  }

  .login-hero {
    padding: 92rpx 0 44rpx;
  }

  .hero-badge {
    font-size: 20rpx;
    padding: 0 14rpx;
  }

  .app-icon {
    font-size: 72rpx;
    margin: 18rpx 0 14rpx;
  }

  .app-title {
    font-size: 38rpx;
  }

  .app-desc {
    max-width: none;
    font-size: 22rpx;
  }

  .login-form {
    padding: 30rpx 22rpx;
  }

  .form-title {
    font-size: 32rpx;
  }

  .form-subtitle,
  .footer-text {
    font-size: 22rpx;
  }

  .form-label {
    font-size: 24rpx;
  }

  .form-input,
  .login-btn {
    min-height: 82rpx;
    font-size: 26rpx;
  }
}
