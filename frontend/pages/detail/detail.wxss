.detail-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(240, 246, 255, 0.98) 100%);
}

.detail-hero-main {
  flex: 1;
  min-width: 0;
}

.detail-name {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1f2a37;
  line-height: 1.36;
  letter-spacing: 0.4rpx;
  word-break: break-word;
}

.detail-trade {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #7b8794;
  word-break: break-word;
}

.header-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.hero-side {
  min-width: 150rpx;
  flex-shrink: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  text-align: center;
}

.hero-side-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: #7b8794;
}

.hero-side-value {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.25;
  letter-spacing: 0.3rpx;
  font-weight: 700;
  color: #ff7a45;
}

.fold-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.toggle-icon {
  font-size: 22rpx;
  line-height: 1.45;
  color: #7b8794;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1f5;
  font-size: 28rpx;
  line-height: 1.65;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-row .label {
  color: #7b8794;
  width: 160rpx;
  flex-shrink: 0;
  letter-spacing: 0.2rpx;
}

.detail-row .value {
  color: #243447;
  flex: 1;
  line-height: 1.65;
  min-width: 0;
  word-break: break-word;
}

.stock-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stock-item {
  flex: 1;
  min-width: 180rpx;
  text-align: center;
  background: #f7f9fc;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
}

.stock-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  color: #7b8794;
  margin-bottom: 8rpx;
}

.stock-value {
  display: block;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 600;
  word-break: break-word;
}

.stock-status-banner {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.stock-status-normal {
  background: #edf9e8;
  color: #389e0d;
}

.stock-status-danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.text-success { color: #52C41A; }
.text-warning { color: #FAAD14; }
.text-danger  { color: #FF4D4F; }

.detail-text {
  font-size: 28rpx;
  color: #52606d;
  line-height: 1.9;
  text-align: justify;
  margin-top: 16rpx;
}

.action-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 8rpx 0 20rpx;
}

.btn-edit {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #2c7ef8 0%, #4e8fff 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 0.6rpx;
  box-shadow: 0 10rpx 24rpx rgba(44, 126, 248, 0.18);
}

.btn-edit:active { opacity: 0.95; }

.btn-stock {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 20rpx;
  background: #f6ffed;
  color: #389e0d;
  border: 2rpx solid #d9f7be;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 0.6rpx;
}

.btn-stock:active { background: #edf9e8; }

.btn-delete {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 20rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ffccd0;
  border-radius: 999rpx;
  font-size: 28rpx;
  letter-spacing: 0.6rpx;
}

.btn-delete:active { background: #fff5f5; }

.doctor-tip {
  font-size: 26rpx;
  color: #52606d;
  line-height: 1.85;
  padding: 8rpx 0;
  word-break: break-word;
}

@media (max-width: 375px) {
  .detail-hero {
    flex-direction: column;
  }

  .hero-side {
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  .detail-name {
    font-size: 38rpx;
  }

  .detail-row {
    flex-direction: column;
    gap: 6rpx;
  }

  .detail-row .label {
    width: auto;
  }

  .stock-grid {
    gap: 12rpx;
  }

  .stock-item {
    min-width: calc(50% - 6rpx);
  }

  .btn-edit,
  .btn-delete {
    width: 100%;
    flex: none;
  }
}
